{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hithozha",
  "compatibility_date": "2026-10-01",
  // Cloudflare runs this before uploading, so a push is all it takes to publish.
  "build": { "command": "npm run build:web" },
  "assets": {
    "directory": "dist",
    // Unknown paths such as /orders/123 open the app instead of a 404.
    "not_found_handling": "single-page-application"
  }
}
