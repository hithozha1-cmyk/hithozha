# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# env (public client keys only, but keep local)
.env

# local Claude Code session files
.claude/

# Cloudflare Wrangler local state
.wrangler/

# Generated: all migrations in one file for pasting into a new project
supabase/all-migrations.sql

# Firebase service-account keys are secrets. Never commit them.
*firebase-adminsdk*.json
service-account*.json
